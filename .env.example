# Church Service Recorder Configuration
# Copy this file to .env and fill in your actual values

# Required: Telegram notification settings
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Required: Server timezone (affects scheduling)
# Use TZ database names like: America/St_Johns, America/Toronto, etc.
TIMEZONE=America/St_Johns

# Optional: Logging level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: OpenAI API key (if using OpenAI for transcription instead of local Whisper)
OPENAI_API_KEY=

# Optional: Legacy single-stream mode (use streams.yml for multi-stream instead)
STREAM_URL=
STREAM_STATUS_URL=

# Optional: Local timezone for Docker container
TZ=America/St_Johns

# Web UI admin login (config editor). Generate both values with:
#   python set_admin_password.py
# Keep the single quotes — the hash contains '$', which compose would otherwise expand.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
FLASK_SECRET_KEY=
# 1 = cookies only sent over HTTPS (Cloudflare tunnel). 0 to log in over plain http on the LAN.
SESSION_COOKIE_SECURE=1
# Addresses cloudflared connects from (IPs or CIDRs, comma-separated). Only requests
# from these may set CF-Connecting-IP; everyone else is identified by their own IP.
TRUSTED_PROXY_IPS=192.168.0.20,100.78.23.97
